{
	"name": "@aronia/svelte",
	"version": "0.0.1",
	"private": true,
	"description": "The aronia registry source + docs site (SvelteKit). aronia ships as the `aronia` CLI (copy-into-repo); this repo is not published as an importable package.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Chukwuka-Osakwe/aronia.git"
	},
	"homepage": "https://github.com/Chukwuka-Osakwe/aronia#readme",
	"bugs": "https://github.com/Chukwuka-Osakwe/aronia/issues",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run registry && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:contrast": "node scripts/contrast-audit.mjs",
		"capture:hero": "node scripts/capture-hero.mjs",
		"registry": "tsx scripts/build-registry.ts"
	},
	"workspaces": [
		"cli"
	],
	"type": "module",
	"devDependencies": {
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@fontsource/space-mono": "^5.3.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"playwright": "^1.63.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.19.2",
		"typescript": "^6.0.3",
		"vite": "^7.3.6"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.2.8",
		"@fontsource-variable/geist-mono": "^5.2.8",
		"@fontsource-variable/gluten": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/suse": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.2.7"
	}
}
